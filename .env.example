# Copy to .env for local runs (never commit the real .env).
# In GitHub Actions, set these as repository Secrets instead.

# --- Required ---
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_HOST_A=
ELEVENLABS_VOICE_ID_HOST_B=

# A hard-to-guess path segment used to keep the RSS feed/audio "private by
# obscurity" on GitHub Pages (anyone with the URL can access it, but it
# isn't linked or listed anywhere). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
PODCAST_SLUG=

# --- Optional ---
# Base URL where GitHub Pages serves this repo's /docs folder.
# Defaults to https://<owner>.github.io/<repo> when running in GitHub Actions.
PODCAST_BASE_URL=

PODCAST_TITLE=Daily Briefing
PODCAST_AUTHOR=Shane Galligan
PODCAST_EMAIL=
HOST_A_NAME=Alex
HOST_B_NAME=Jordan

# Anthropic model used to write the script.
CLAUDE_MODEL=claude-sonnet-5

# ElevenLabs TTS model.
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Optional: free API key from https://www.football-data.org for richer
# Premier League fixtures/results. Falls back to Google News if unset.
FOOTBALL_DATA_API_KEY=
